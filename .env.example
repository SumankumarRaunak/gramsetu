# ------------------------------------------------------------------
# Gram Setu - environment variables
# Copy this file to .env and fill in real values.
# ------------------------------------------------------------------

# Supabase project URL + anon (publishable) key - used by the Vite frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: use this as the OAuth redirect origin in deployed environments.
# If omitted, the browser origin is used automatically.
VITE_SITE_URL=http://localhost:3000

# Service role key - NEVER used in the browser.
# Only used by admin scripts such as `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP settings for the send-complaint-email Edge Function.
# (Deployed as Edge Function secrets, NOT read by Vite.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
